# Run mode: "demo" (all in the browser on localStorage) or "live" (Supabase).
# Demo is the default when unset.
VITE_MODE=demo

# ---- Only needed when VITE_MODE=live ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tenant slug used by the public create_booking RPC. Keep "default" for a
# single-client instance; set per client when running multi-tenant.
VITE_TENANT_SLUG=default
