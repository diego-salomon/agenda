# Edge Function secrets. Copy to supabase/functions/.env, fill it in, and load with:
#   supabase secrets set --env-file supabase/functions/.env
# Commit only this example — never the real .env.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically for
# deployed functions, so they are not listed here.

# Reminder window, in hours before the appointment. Mirror reminderLeadHours in
# src/config/agenda.config.ts.
REMINDER_LEAD_HOURS=24
TENANT_SLUG=default

# Your messaging provider, wired in functions/notify/deliver(). Fill one set.
# Twilio (SMS):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or WhatsApp Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
